<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PopNomerSem.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
			<SearchBar x:Name="SearchBar" Placeholder="Find your note" TextChanged="SearchBar_TextChanged"/>
			<ListView x:Name="NotesList">
				<ListView.ItemTemplate>
					<DataTemplate>
						<TextCell Text="{Binding Title}" Detail="{Binding Date}" />
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>
			<Button Text="Add new note" Clicked="Button_Clicked"/>
		</VerticalStackLayout>
    </ScrollView>

</ContentPage>
